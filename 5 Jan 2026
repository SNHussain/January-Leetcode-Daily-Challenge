class Solution {
public:
    long long maxMatrixSum(vector<vector<int>>& matrix) {
        int minAbs = INT_MAX;
        int n = matrix.size();
        long long sum = 0;
        int negativeCount = 0;

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                int val = matrix[i][j];

                if(val<0) negativeCount++;

                int absVal = abs(val);
                sum += absVal;
                minAbs = min(minAbs, absVal);
            }
        }

       if(negativeCount % 2 == 1) {
            sum -= 2LL * minAbs;
        }



        return sum;

    }
};
